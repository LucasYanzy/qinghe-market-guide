{
  "name": "qinghe-market-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "build:public": "tsc --noEmit && vite build --mode public",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:ui": "playwright test",
    "test:public": "playwright test --config playwright.public.config.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}

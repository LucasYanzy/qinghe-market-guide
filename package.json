{
  "name": "rutgers-community-farmers-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "setup:admin": "node scripts/setup-admin.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:ui": "npm run build && playwright test",
    "check": "npm run build && npm run build:public && npm test",
    "build:public": "vite build --config vite.public.config.ts",
    "preview:public": "vite preview --config vite.public.config.ts --host 127.0.0.1",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:public": "npm run build:public && playwright test --config playwright.public.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.2.0",
    "sql.js": "^1.15.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}

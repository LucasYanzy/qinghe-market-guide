# Node does not read this file automatically. Export variables before startup.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/market.sqlite
# Demo mode seeds fictional users, inventory and historical prices.
# For a production deployment use DEMO_MODE=false with a NEW database.
DEMO_MODE=true
# Enable when serving through HTTPS in production.
COOKIE_SECURE=false

# Optional email outbox delivery via the explicit notifications:deliver command.
# Keep secrets outside version control; API requests only queue mail.
RESEND_API_KEY=
MAIL_FROM=

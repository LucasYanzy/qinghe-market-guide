# npm run dev / npm start load .env through Node's built-in environment loader.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/market.sqlite
# Demo mode seeds fictional users, inventory and historical prices.
# For a production deployment use DEMO_MODE=false with a NEW database.
DEMO_MODE=true
# Enable when serving through HTTPS in production.
COOKIE_SECURE=false
# Set to the exact HTTPS origin of your full-stack deployment.
# PUBLIC_ORIGIN=https://your-market.up.railway.app
# Number of trusted reverse-proxy hops. Railway normally uses one; direct hosting uses zero.
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000
